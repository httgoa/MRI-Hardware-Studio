{# ===== Tier A template: Discrete feed port (coordinate-based) =====
   Renders ONE raw CST history block (NO Sub Main — add_to_history).
   Distilled from ../building-blocks/vba-blocks/dipole-build.md (verified from-scratch).
   CRITICAL: SetP1/SetP2 first arg "False" = use free coordinates (NOT a picked
   point). Passing "True" without a pre-picked point fails with
   "No points picked for location of discrete port". Run AFTER geometry.
   Vars (optional): port_number, impedance, px, y_lo, y_hi, pz
     (defaults span the dipole feed gap at X=0, mid-thickness Z=T/2)
#}
' ===== Feed port: coordinate-based DiscretePort across the feed gap =====
' Generated by MRI Agent (Tier A: templates/ports.vba.j2)
With DiscretePort
    .Reset
    .PortNumber "{{ port_number | default('1') }}"
    .Type "SParameter"
    .Label ""
    .Impedance "{{ impedance | default('50.0') }}"
    .Voltage "1.0"
    .Current "1.0"
    .Monitor "True"
    .Radius "0.0"
    .SetP1 "False", "{{ px | default('0') }}", "{{ y_lo | default('-hole') }}", "{{ pz | default('T/2') }}"   ' False = free coordinates
    .SetP2 "False", "{{ px | default('0') }}", "{{ y_hi | default('hole') }}", "{{ pz | default('T/2') }}"
    .InvertDirection "False"
    .LocalCoordinates "False"
    .Wire ""
    .Position "end1"
    .Create
End With
