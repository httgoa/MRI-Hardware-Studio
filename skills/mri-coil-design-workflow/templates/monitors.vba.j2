' ===== Field Monitors =====
' Generated by MRI Agent

{% for freq in monitor_frequencies %}
With Monitor
  .Reset
  .Name "e-field (f={{ freq }})"
  .Dimension "Volume"
  .Domain "Frequency"
  .FieldType "Efield"
  .MonitorValue "{{ freq }}"
  .UseSubvolume "False"
  .Create
End With

With Monitor
  .Reset
  .Name "h-field (f={{ freq }})"
  .Dimension "Volume"
  .Domain "Frequency"
  .FieldType "Hfield"
  .MonitorValue "{{ freq }}"
  .UseSubvolume "False"
  .Create
End With

{% set _raw_include_loss_monitor = include_loss_monitor | default(false) %}
{% set _include_loss_monitor = (_raw_include_loss_monitor | string | lower) in ['true', '1', 'yes', 'on'] %}
{% if _include_loss_monitor %}
With Monitor
  .Reset
  .Name "loss (f={{ freq }})"
  .Dimension "Volume"
  .Domain "Frequency"
  .FieldType "Powerloss"
  .MonitorValue "{{ freq }}"
  .UseSubvolume "False"
  .Create
End With

{% endif %}
{% endfor %}
