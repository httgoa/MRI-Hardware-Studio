' ===== Common Setup =====
' Generated by MRI Agent
' Target: {{ field_strength_t }}T ({{ target_freq_mhz }} MHz)

' --- Units ---
With Units
  .Geometry "{{ units_geometry | default('mm') }}"
  .Frequency "{{ units_frequency | default('MHz') }}"
  .Time "{{ units_time | default('ns') }}"
  .TemperatureUnit "Kelvin"
End With

' --- Frequency Range ---
Solver.FrequencyRange "{{ freq_min }}", "{{ freq_max }}"

' --- Boundary Conditions ---
' NOTE: use API boundary VALUES, not GUI labels. Valid: "electric", "magnetic",
' "normal", "tangential", "periodic", "open", "expanded open",
' "expanded lf open", "impedance", "unit cell". ("open (add space)" is the GUI
' label and is REJECTED by the VBA API.) Ground truth uses "expanded open".
With Boundary
  .Xmin "{{ boundary | default('expanded open') }}"
  .Xmax "{{ boundary | default('expanded open') }}"
  .Ymin "{{ boundary | default('expanded open') }}"
  .Ymax "{{ boundary | default('expanded open') }}"
  .Zmin "{{ boundary | default('expanded open') }}"
  .Zmax "{{ boundary | default('expanded open') }}"
End With

' --- Background Material ---
With Background
  .Type "Normal"
  .Epsilon "1.0"
  .Mu "1.0"
  .XminSpace "0"
  .XmaxSpace "0"
  .YminSpace "0"
  .YmaxSpace "0"
  .ZminSpace "0"
  .ZmaxSpace "0"
End With
