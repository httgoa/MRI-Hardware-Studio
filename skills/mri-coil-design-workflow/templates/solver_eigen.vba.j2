' ===== Eigenmode Solver Setup =====
' Generated by MRI Agent

Sub Main

With EigenmodeSolver
  .SetMethod "AKS"
  .SetMeshType "Tetrahedral"
  .SetNumberOfModes "{{ num_modes | default(20) }}"
  .SetFrequencyTarget "True", "{{ target_freq_mhz }}"
  .SetMaterialEvaluationFrequency "True", "{{ target_freq_mhz }}"
  .SetAccuracy "{{ accuracy | default('1e-6') }}"
  .Start
End With

End Sub
