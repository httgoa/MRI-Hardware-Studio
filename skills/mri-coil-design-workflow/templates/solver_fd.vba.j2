' ===== HF Frequency Domain solver (tetrahedral) =====
' Generated by MRI Agent (Tier A: templates/solver_fd.vba.j2)
ChangeSolverType "HF Frequency Domain"
With FDSolver
    .Reset
    .SetMethod "Tetrahedral", "General purpose"
    .OrderTet "{{ order_tet | default('Second') }}"
    .Stimulation "All", "1"
    .AccuracyTet "{{ accuracy_tet | default('1e-4') }}"
    .MeshAdaptionTet "{{ mesh_adaption | default('True') }}"
    .CalcPowerLoss "{{ calc_power_loss | default('True') }}"
    .SetKeepSolutionCoefficients "MonitorsAndMeshAdaptation"
End With
