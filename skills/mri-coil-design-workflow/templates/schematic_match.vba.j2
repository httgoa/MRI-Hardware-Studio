{# ===== Tier A template: schematic net wiring (L-match) =====
   Renders schematic VBA that defines the electrical nets — run via
   cst_schematic_execute_vba_tool. This is the DETERMINISTIC, error-prone piece
   of the matching network (Net.AddComponentPorts one-shot per node). Element
   PLACEMENT (cst_add_inductor_tool etc. with the 50000 coord origin) and TUNING
   stay procedural in the recipe — they are MCP-tool / decision work, not a
   template. Distilled from ../building-blocks/vba-blocks/dipole-schematic.md.

   Ground-truth L-match: ExtPort + Lt(series) + Lp(shunt→GND) + MWSSCHEM1.
   Three nets: input junction, ground, dipole. Cp is NOT wired (spare).
   ⚠️ One statement per line — no colon ':' multi-statement (MCP VBA rejects it).
   ⚠️ AddComponentPorts ≤ 4 pins per net (pitfall #16); these nets are ≤3.
   Vars (optional): ext_port ('1'), lt ('Lt'), lp ('Lp'), gnd ('GND1'),
     block ('MWSSCHEM1')
#}
' ===== Schematic net wiring (L-match: input / ground / dipole nets) =====
' Generated by MRI Agent (Tier A: templates/schematic_match.vba.j2)

' --- Input (junction) node: ExtPort + Lt.0 + Lp.0  (NO Cp) ---
Dim P1(2,2) As Variant
P1(0,0)="Externalport"
P1(0,1)="{{ ext_port | default('1') }}"
P1(0,2)=0
P1(1,0)="BLOCK"
P1(1,1)="{{ lt | default('Lt') }}"
P1(1,2)=0
P1(2,0)="BLOCK"
P1(2,1)="{{ lp | default('Lp') }}"
P1(2,2)=0
With Net
    .Reset
    .AddComponentPorts "", P1, False
    .Apply
End With

' --- Ground node: Lp.1 + GND.0 ---
Dim P2(1,2) As Variant
P2(0,0)="BLOCK"
P2(0,1)="{{ lp | default('Lp') }}"
P2(0,2)=1
P2(1,0)="BLOCK"
P2(1,1)="{{ gnd | default('GND1') }}"
P2(1,2)=0
With Net
    .Reset
    .AddComponentPorts "", P2, False
    .Apply
End With

' --- Dipole node: Lt.1 + MWSSCHEM1.0 ---
Dim P3(1,2) As Variant
P3(0,0)="BLOCK"
P3(0,1)="{{ lt | default('Lt') }}"
P3(0,2)=1
P3(1,0)="BLOCK"
P3(1,1)="{{ block | default('MWSSCHEM1') }}"
P3(1,2)=0
With Net
    .Reset
    .AddComponentPorts "", P3, False
    .Apply
End With
