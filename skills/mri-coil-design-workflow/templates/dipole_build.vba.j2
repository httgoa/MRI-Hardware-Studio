{# ===== Tier A template: Dipole structure (parameters + geometry) =====
   Renders ONE raw CST history block (NO Sub Main — goes through add_to_history).
   Distilled verbatim from ../building-blocks/vba-blocks/dipole-build.md (verified 5T/210MHz).
   Units: Length mm, Frequency GHz.  Run AFTER materials.vba.j2 (geometry references materials).
   Vars (all optional, defaults = verified project values):
     L_line, W_line, T, hole, W_total, L_total,
     T_FR4, T_polycarbonate, T_foam, T_dipolet_to_plantom,
     x_plantom, y_plantom, z_plantom,
     mat_fr4, mat_poly, mat_foam, mat_phantom,
     include_support_stack (default true; data-prep complete cases set false)
#}
{% set _raw_include_support_stack = include_support_stack | default(true) %}
{% set _include_support_stack = (_raw_include_support_stack | string | lower) not in ['false', '0', 'no', 'off'] %}
' ===== Dipole structure: parameters + geometry =====
' Generated by MRI Agent (Tier A: templates/dipole_build.vba.j2)

' --- Parameters (dipole-specific; substrate/setup handled elsewhere) ---
MakeSureParameterExists("L_line", "{{ L_line | default('300') }}")
MakeSureParameterExists("W_line", "{{ W_line | default('5') }}")
MakeSureParameterExists("T", "{{ T | default('0.35') }}")
MakeSureParameterExists("hole", "{{ hole | default('1') }}")
{% if _include_support_stack %}
MakeSureParameterExists("W_total", "{{ W_total | default('50') }}")
MakeSureParameterExists("L_total", "{{ L_total | default('L_line+50') }}")
MakeSureParameterExists("T_FR4", "{{ T_FR4 | default('1.5') }}")
MakeSureParameterExists("T_polycarbonate", "{{ T_polycarbonate | default('18') }}")
MakeSureParameterExists("T_foam", "{{ T_foam | default('1') }}")
MakeSureParameterExists("T_dipolet_to_plantom", "{{ T_dipolet_to_plantom | default('T_FR4+T_polycarbonate+T_foam') }}")
{% else %}
MakeSureParameterExists("T_dipolet_to_plantom", "{{ T_dipolet_to_plantom | default('40') }}")
{% endif %}
MakeSureParameterExists("x_plantom", "{{ x_plantom | default('270') }}")
MakeSureParameterExists("y_plantom", "{{ y_plantom | default('650') }}")
MakeSureParameterExists("z_plantom", "{{ z_plantom | default('300') }}")

' --- Dipole conductor (PEC) with feed gap subtracted ---
Component.New "component1"
With Brick
    .Reset : .Name "Dipole1" : .Component "component1" : .Material "PEC"
    .Xrange "W_line/2", "-W_line/2" : .Yrange "L_line/2", "-L_line/2" : .Zrange "0", "T" : .Create
End With
With Brick
    .Reset : .Name "hole" : .Component "component1" : .Material "{% if _include_support_stack %}{{ mat_fr4 | default('FR-4 (lossy)') }}{% else %}PEC{% endif %}"
    .Xrange "-W_line/2", "W_line/2" : .Yrange "-hole", "hole" : .Zrange "0", "T" : .Create
End With
Solid.Subtract "component1:Dipole1", "component1:hole"

{% if _include_support_stack %}
' --- Substrate stack below the dipole (-Z): FR4 / holder / foam / phantom ---
With Brick
    .Reset : .Name "FR4_board" : .Component "component1" : .Material "{{ mat_fr4 | default('FR-4 (lossy)') }}"
    .Xrange "-W_total/2", "W_total/2" : .Yrange "-L_total/2", "L_total/2" : .Zrange "-T_FR4", "0" : .Create
End With
With Brick
    .Reset : .Name "polycarbonate_board" : .Component "component1" : .Material "{{ mat_poly | default('Folder_MyTong/polycarbonate') }}"
    .Xrange "-W_total/2", "W_total/2" : .Yrange "-L_total/2", "L_total/2" : .Zrange "-T_FR4", "-T_FR4-T_polycarbonate" : .Create
End With
With Brick
    .Reset : .Name "foam" : .Component "component1" : .Material "{{ mat_foam | default('Folder_MyTong/foam') }}"
    .Xrange "-W_total/2", "W_total/2" : .Yrange "-L_total/2", "L_total/2" : .Zrange "-T_dipolet_to_plantom", "-T_dipolet_to_plantom+T_foam" : .Create
End With
With Brick
    .Reset : .Name "plantom" : .Component "component1" : .Material "{{ mat_phantom | default('Folder_MyTong/plantom') }}"
    .Xrange "-x_plantom/2", "x_plantom/2" : .Yrange "-y_plantom/2", "y_plantom/2" : .Zrange "-T_dipolet_to_plantom", "-T_dipolet_to_plantom-z_plantom" : .Create
End With
{% else %}
' --- Data-prep substrate-free layout: coil + phantom only ---
With Brick
    .Reset : .Name "plantom" : .Component "component1" : .Material "{{ mat_phantom | default('Folder_MyTong/plantom') }}"
    .Xrange "-x_plantom/2", "x_plantom/2" : .Yrange "-y_plantom/2", "y_plantom/2" : .Zrange "-T_dipolet_to_plantom", "-T_dipolet_to_plantom-z_plantom" : .Create
End With
{% endif %}
