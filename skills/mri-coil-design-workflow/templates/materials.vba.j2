{# ===== Tier A template: MRI material set (with distinct colours) =====
   Renders ONE raw CST history block (NO Sub Main — add_to_history).
   Distilled from ../building-blocks/vba-blocks/dipole-build.md. Run BEFORE geometry.
   Each material gets a distinct .Colour so the 3D viewport is visually clear;
   phantom is semi-transparent so the coil underneath is visible.
   Vars (optional): fr4_eps, fr4_tand, poly_eps, poly_tand, foam_eps,
     phantom_eps, phantom_sigma, phantom_rho, folder
#}
{% set _raw_include_support_materials = include_support_materials | default(true) %}
{% set _include_support_materials = (_raw_include_support_materials | string | lower) not in ['false', '0', 'no', 'off'] %}
' ===== Materials (MRI set, distinct colours) =====
' Generated by MRI Agent (Tier A: templates/materials.vba.j2)

{% if _include_support_materials %}
' FR-4 substrate — tan/khaki
With Material
    .Reset : .Name "FR-4 (lossy)" : .Folder "" : .Type "Normal"
    .Epsilon "{{ fr4_eps | default('4.3') }}" : .Mu "1.0" : .TanD "{{ fr4_tand | default('0.025') }}" : .TanDGiven "True" : .TanDModel "ConstTanD"
    .Colour "0.94", "0.82", "0.76"
    .Create
End With

' Polycarbonate (holder) — light blue
With Material
    .Reset : .Name "polycarbonate" : .Folder "{{ folder | default('Folder_MyTong') }}" : .Type "Normal"
    .Epsilon "{{ poly_eps | default('2.9') }}" : .Mu "1" : .TanD "{{ poly_tand | default('0.01') }}" : .TanDGiven "True" : .TanDModel "ConstTanD"
    .Colour "0.65", "0.81", "0.94"
    .Create
End With

' Foam (spacer) — very light grey
With Material
    .Reset : .Name "foam" : .Folder "{{ folder | default('Folder_MyTong') }}" : .Type "Normal"
    .Epsilon "{{ foam_eps | default('1.05') }}" : .Mu "1"
    .Colour "0.90", "0.90", "0.90"
    .Create
End With
{% endif %}

' Tissue phantom (lossy) — translucent red/pink
With Material
    .Reset : .Name "plantom" : .Folder "{{ folder | default('Folder_MyTong') }}" : .Type "Normal"
    .Epsilon "{{ phantom_eps | default('78') }}" : .Mu "1" : .Sigma "{{ phantom_sigma | default('0.47') }}" : .Rho "{{ phantom_rho | default('1000') }}"
    .Colour "0.85", "0.35", "0.35"
    .Transparency "0.6"
    .Create
End With
